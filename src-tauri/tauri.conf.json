{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zalo",
  "version": "2026.11.11",
  "identifier": "com.o365serveronms.zalors",
  "build": {
    "frontendDist": "../settings-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "name": "Zalo link",
        "schemes": [
          "zalors"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "macOS": {
      "minimumSystemVersion": "12.1"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/com.o365serveronms.zalors.policy": "resources/com.o365serveronms.zalors.policy"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "PortugueseBR"
        ],
        "installMode": "currentUser",
        "startMenuFolder": "Zalo",
        "template": "windows/installer.nsi"
      }
    }
  }
}
